# Public runtime config for Next.js (safe to commit)

# Backend API base URL (same-origin recommended in production via Nginx proxy)
NEXT_PUBLIC_API_URL=https://malaikanest.duckdns.org

# Public site URL (used for SEO metadata, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://malaikanest.duckdns.org

# Brand name
NEXT_PUBLIC_SITE_NAME=Malaika Nest

# WhatsApp number in international format without "+" (used for wa.me links)
NEXT_PUBLIC_WHATSAPP_NUMBER=254726771321

# Optional (reCAPTCHA/Turnstile) site key used by login/register if enabled server-side
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
