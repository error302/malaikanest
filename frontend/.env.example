# Malaika Nest — Environment Variables
# Copy this file to .env.local and fill in real values.

# Django backend API URL (used by both server-side fetch and client axios).
NEXT_PUBLIC_API_URL=https://malaikanest.duckdns.org

# Internal API URL for server-side fetch (SSR/ISR). Falls back to NEXT_PUBLIC_API_URL.
# INTERNAL_API_URL=http://10.0.0.5:8000

# Public site URL (used for canonical URLs and OpenGraph).
NEXT_PUBLIC_SITE_URL=https://malaikanest.duckdns.org

# Database (Prisma) — local SQLite for the CMS
DATABASE_URL="file:./../db/custom.db"

# Mailchimp (optional — newsletter form falls back to local DB if not set)
# Get these from https://mailchimp.com → Account → API keys
# MAILCHIMP_API_KEY=abcd1234-us12
# MAILCHIMP_LIST_ID=abc123def4
# MAILCHIMP_DC=us12
