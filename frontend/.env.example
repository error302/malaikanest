# Malaika Nest — Environment Variables
# Copy this file to .env.local and fill in real values.

# Django backend API URL (used by both server-side fetch and client axios).
# In production, point this at your Django instance (e.g. https://malaikanest.duckdns.org).
# For local dev with Django on :8000, leave empty — the client auto-detects localhost:8000.
NEXT_PUBLIC_API_URL=https://malaikanest.duckdns.org

# Internal API URL for server-side fetch (SSR/ISR). Falls back to NEXT_PUBLIC_API_URL.
# Use this if the Django backend is reachable via a private network IP from the Next.js host.
# INTERNAL_API_URL=http://10.0.0.5:8000

# Public site URL (used for canonical URLs and OpenGraph).
NEXT_PUBLIC_SITE_URL=https://malaikanest.duckdns.org

# Database (Prisma) — only needed if you run Prisma migrations locally.
# The storefront itself calls the Django API; Prisma is for the schema documentation.
DATABASE_URL=postgresql://postgres:password@localhost:5432/malaika_dev?schema=public
