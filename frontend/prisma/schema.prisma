// ─────────────────────────────────────────────────────────────────────────────
// Malaika Nest — Active Prisma Schema (SQLite)
//
// This schema manages the Next.js-side content management system (CMS):
// site branding, homepage content blocks, and testimonials. The storefront
// reads from these tables with hardcoded fallback defaults, so the site
// works even before the admin configures anything.
//
// The full Django backend schema (products, orders, payments, etc.) is
// documented in `schema-django-reference.prisma` — those tables live in
// PostgreSQL on the Django side and are accessed via the REST API.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Site Branding ─────────────────────────────────────────────────────────────
// Singleton-style key/value store for global branding: logo URL, favicon URL,
// store name, tagline, announcement bar messages, social links, etc.
// Keys are namespaced (e.g. "branding.logo_url", "announcement.message_1").

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ── Homepage Content Blocks ──────────────────────────────────────────────────
// Editable text for each homepage section. Admin can change labels, titles,
// subtitles, CTAs without touching code. Falls back to defaults if missing.

model ContentBlock {
  id        String   @id @default(cuid())
  section   String   // e.g. "hero", "shop_by_age", "featured", "value_props", "newsletter"
  key       String   // e.g. "label", "title", "subtitle", "cta_text", "cta_href"
  value     String
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([section, key])
  @@index([section, isActive])
  @@map("content_blocks")
}

// ── Testimonials ─────────────────────────────────────────────────────────────
// Customer reviews shown on the homepage. Full CRUD from admin dashboard.

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  location  String
  rating    Int      @default(5)
  text      String
  product   String?
  initials  String?
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
  @@map("testimonials")
}

// ── Value Propositions ───────────────────────────────────────────────────────
// The 4 trust badges on the homepage (Safe Materials, Fast Delivery, etc.)

model ValueProp {
  id        String   @id @default(cuid())
  icon      String   // lucide icon name: "Shield", "Truck", "Heart", "CreditCard"
  title     String
  subtitle  String
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
  @@map("value_props")
}

// ── Thrifted / Mtumba Products ───────────────────────────────────────────────
// One-of-a-kind secondhand clothing. Each item is unique (stock = 1) and gets
// marked isSold=true when purchased. Has condition grading + original brand.
// Separate from the regular Product catalog (which lives in Django).

model ThriftedProduct {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String   @default("")
  price         Decimal
  originalPrice Decimal? // estimated retail when new
  condition     String   @default("good")   // "like_new" | "good" | "fair"
  brand         String   @default("")       // original brand (e.g. "Next", "H&M")
  size          String   @default("")       // "0-3m", "2y", "6y", etc.
  gender        String   @default("unisex") // "boy" | "girl" | "unisex"
  ageGroup      String   @default("")       // "baby" | "toddler" | "kids"
  image         String
  image2        String?
  image3        String?
  isAvailable   Boolean  @default(true)     // false once sold
  isFeatured    Boolean  @default(false)    // show on homepage thrifted section
  isActive      Boolean  @default(true)     // admin can hide without deleting
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isAvailable, isActive])
  @@index([isFeatured, isActive])
  @@index([condition])
  @@index([gender])
  @@index([ageGroup])
  @@index([createdAt])
  @@map("thrifted_products")
}
