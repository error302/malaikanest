# ============================================
# MALAIKA NEST ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in the values

# ------------------------------
# DJANGO SETTINGS
# ------------------------------
SECRET_KEY=your-secret-key-here
ENVIRONMENT=production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,malaikanest.com
FRONTEND_URL=https://malaikanest.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/malaikanest

# ------------------------------
# JWT AUTHENTICATION
# ------------------------------
SIMPLE_JWT_SECRET=your-jwt-signing-key-here

# ------------------------------
# LOGIN LOCKOUT + CAPTCHA
# ------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=1800
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY=your-turnstile-secret
CAPTCHA_ENFORCE_LOGIN=True
CAPTCHA_ENFORCE_REGISTER=True

# ------------------------------
# M-PESA PAYMENT SETTINGS (Daraja)
# ------------------------------
# You cannot STK-push without a Daraja app. Register at
# https://developer.safaricom.co.ke, create a LIVE app, and enable the
# "M-Pesa Express" (STK Push) product. Until then set MPESA_MOCK_MODE=false and
# use the manual "till" checkout method, which needs no API credentials at all.
MPESA_ENV=live
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret

# MERCHANT IDENTITY - read this carefully, it is the #1 cause of
# 500.001.1001 "[MerchantValidate] - Wrong credentials".
#
# Set EXACTLY ONE of the two below, and it must be the number that OWNS the
# MPESA_PASSKEY issued to your Daraja app:
#   Buy Goods (till) -> set MPESA_TILL_NUMBER only, leave SHORT_CODE empty
#   Paybill          -> set MPESA_BUSINESS_SHORT_CODE only, leave TILL empty
# resolve_merchant_code() in apps/payments/services.py then uses that single
# value for BusinessShortCode, PartyB AND the Password. Previously these could
# disagree, which made Safaricom decode the password against one merchant while
# being asked to route money to another.
#
# NOTE 174379 is the Daraja SANDBOX shortcode. It must never appear in a live
# config - the old default silently broke STK query reconciliation.
MPESA_TILL_NUMBER=3370347
MPESA_BUSINESS_SHORT_CODE=
MPESA_STORE_NUMBER=3104615

# The passkey is issued per Daraja app and pairs with ONE merchant number.
MPESA_PASSKEY=your-passkey

# Must be https, publicly reachable, and NOT challenged by Cloudflare.
# Cloudflare -> Security -> WAF -> Custom rules needs a SKIP rule for this path,
# otherwise Safaricom's server-to-server callback receives a "Just a moment..."
# interstitial and Django never sees it: the customer pays and the order stays
# pending forever.
MPESA_CALLBACK_URL=https://api.malaikanest.com/api/v1/payments/mpesa/callback/

# Callback signature verification. Strongly preferred: download Safaricom's
# public certificate, mount it, and turn strict mode on.
MPESA_PUBLIC_KEY_PATH=
MPESA_STRICT_SIGNATURE=false
# Only set this to true if you must launch before the certificate exists. It
# silences the guard in config/settings/guards.py and leaves the IP allowlist
# (196.201.213.0/24, 196.201.214.0/24) as your only defence - confirm those
# egress ranges with Safaricom, they change.
MPESA_CALLBACK_SIGNATURE_RISK_ACCEPTED=false
MPESA_MOCK_MODE=false

# Set to the number of transactions per minute your till can take, or leave unset.
MPESA_TRANSACTION_TYPE=

# ------------------------------
# PAYPAL (Orders V2)
# ------------------------------
# PAYPAL_CLIENT_ID is public (it ships in the frontend bundle). The secret is not.
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
# PayPal cannot settle in KES, so totals are converted. This rate is used to
# charge the customer, so if it drifts from the real rate you silently over- or
# under-charge. Update it, or wire it to a live rate feed.
KES_USD_EXCHANGE_RATE=129.0

# ------------------------------
# OBSERVABILITY
# ------------------------------
# /metrics/ is gated. Loopback is always allowed; off-box callers must send
# `Authorization: Bearer $METRICS_TOKEN`. If unset, /metrics/ fails closed
# off-box. Set EXPOSE_METRICS=false to unmount the URL entirely.
METRICS_TOKEN=
EXPOSE_METRICS=true
SENTRY_DSN=

# ------------------------------
# CLOUDINARY (Image Storage)
# ------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ------------------------------
# EMAIL SETTINGS
# ------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Malaika Nest <your-email@gmail.com>

# ------------------------------
# CORS + CSRF
# ------------------------------
CORS_ALLOWED_ORIGINS=https://malaikanest.com
CSRF_TRUSTED_ORIGINS=https://malaikanest.com

# ------------------------------
# REDIS & CELERY
# ------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------
# CONTAINER LOCALE / CLOCK
# ------------------------------
# Safaricom validates the STK Password timestamp in East Africa Time. The backend
# image is python:3.x-slim with no TZ, i.e. UTC, and Django's TIME_ZONE setting
# does NOT change datetime.now(). docker-compose.lean.yml sets TZ explicitly;
# set it here too for any other way of running the app.
TZ=Africa/Nairobi
