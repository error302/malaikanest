[Unit]
Description=Gunicorn WSGI replica for Malaika Nest (redundancy)
Documentation=https://docs.gunicorn.org
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=notify
User=www-data
Group=www-data
RuntimeDirectory=gunicorn-replica
RuntimeDirectoryMode=0755
WorkingDirectory=/var/www/malaikanest/backend
EnvironmentFile=-/var/www/malaikanest/backend/.env.production
Environment=DJANGO_ENV=prod
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod

# Create the socket directory if it doesn't exist
ExecStartPre=/bin/mkdir -p /run/gunicorn-replica
ExecStartPre=/bin/chown www-data:www-data /run/gunicorn-replica

# Bind to a SECOND unix socket so nginx can load-balance across both instances.
# Worker count kept lean for the e2-micro free tier (1 GB RAM).
# Total workers across both services = 4 (3 primary + 1 replica).
# If the VM consistently runs >80% memory, disable this service:
#   sudo systemctl disable --now gunicorn-replica
ExecStart=/var/www/malaikanest/venv/bin/gunicorn \
    --workers 1 \
    --worker-class sync \
    --worker-connections 1000 \
    --bind unix:/run/gunicorn-replica/malaikanest-replica.sock \
    --umask 007 \
    --access-logfile /var/log/malaikanest/gunicorn-replica-access.log \
    --error-logfile /var/log/malaikanest/gunicorn-replica-error.log \
    --log-level info \
    --timeout 120 \
    --graceful-timeout 90 \
    --max-requests 1000 \
    --max-requests-jitter 50 \
    config.wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gunicorn-malaikanest-replica

[Install]
WantedBy=multi-user.target
