[Unit]
Description=Malaika Nest Daily Backup (Docker Compose topology)
Requires=docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/malaikanest/backup.env
ExecStart=/bin/bash /opt/malaikanest/scripts/ops/backup-compose.sh
Nice=10

[Install]
WantedBy=multi-user.target
